# ===================================
# SARAISE Semgrep Ignore Patterns
# ===================================
# Files and patterns to exclude from Semgrep scanning
# ===================================

# Frontend Dockerfile - nginx runs as non-root by default
frontend/Dockerfile

# SQL queries with validated identifiers (see services.py for validation)
# These queries have table/column name validation via regex
backend/src/modules/integration_platform/services.py

# Generated/static database DDL is reviewed through migration tests and database gates.
backend/**/migrations/**

# Test fixtures intentionally exercise insecure and edge-case inputs; production SAST
# remains scoped to runtime code.
backend/**/tests/**
frontend/src/**/__tests__/**
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
